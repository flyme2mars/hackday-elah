# Copy secrets into gitignored files, or export them in the shell.
# .do.env     — DO_MODEL_KEY
# .gemini.env — GEMINI_API_KEY
#
# Planner order when each hop is configured: DigitalOcean → Gemini API → Vertex → local E4B.
# DO_MODEL_KEY=
# SENSE_DO=1
# SENSE_DO_URL=https://inference.do-ai.run/v1/chat/completions
# SENSE_DO_MODEL=gemma-4-31B-it
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# SENSE_GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-26b-a4b-it
# SENSE_GEMINI=0
# GOOGLE_CLOUD_PROJECT=hackathon1-512618
# VERTEX_LOCATION=global
# VERTEX_MODEL=gemma-4-26b-a4b-it-maas
# SENSE_VERTEX=0
# GOOGLE_APPLICATION_CREDENTIALS=
# SENSE_VAULT=$HOME/HackDayVault
# SENSE_MLX_URL=http://127.0.0.1:8787
# SENSE_E4B_URL=http://127.0.0.1:8787/v1/chat/completions
# SENSE_MIN_SCORE=0.50
